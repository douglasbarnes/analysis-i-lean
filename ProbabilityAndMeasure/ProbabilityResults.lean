import ProbabilityAndMeasure.MeasureResults
import Mathlib.Probability.Independence.Basic
import Mathlib.Probability.BorelCantelli

/-!
# Probability and Measure: independence and event limits

Source-facing declarations for the probability-measure part of the opening chapter.
-/

noncomputable section

open scoped BigOperators ENNReal NNReal Topology
open Set Filter MeasureTheory MeasurableSpace
open ProbabilityTheory

namespace ProbabilityAndMeasure

/-- Source lines 650--656 and 660--665: independence of events is precisely independence
of the sigma algebras generated by those events. -/
theorem independent_events_generated_sigma_source {Ω ι : Type*}
    [MeasurableSpace Ω] (A : ι → Set Ω) (P : Measure Ω) :
    ProbabilityTheory.iIndepSet A P ↔
      ProbabilityTheory.iIndep (fun i ↦ MeasurableSpace.generateFrom {A i}) P :=
  ProbabilityTheory.iIndepSet_iff_iIndep A P

/-- Source lines 669--674: independent pi-systems generate independent sigma algebras. -/
theorem independent_generated_piSystems_source {Ω : Type*} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] {C D : Set (Set Ω)}
    (hCm : ∀ s ∈ C, MeasurableSet s) (hDm : ∀ s ∈ D, MeasurableSet s)
    (hC : IsPiSystem C) (hD : IsPiSystem D)
    (hind : ∀ A ∈ C, ∀ B ∈ D, P (A ∩ B) = P A * P B) :
    ProbabilityTheory.Indep (MeasurableSpace.generateFrom C)
      (MeasurableSpace.generateFrom D) P := by
  have hsets : ProbabilityTheory.IndepSets C D P := by
    rw [ProbabilityTheory.IndepSets_iff]
    exact hind
  exact hsets.indep' hCm hDm hC hD

/-- Source lines 701--705: membership in the limsup is occurrence infinitely often. -/
theorem mem_limsup_events_source {Ω : Type*} (A : ℕ → Set Ω) (ω : Ω) :
    ω ∈ Filter.limsup A Filter.atTop ↔ ∀ n, ∃ m ≥ n, ω ∈ A m := by
  simp [Filter.mem_limsup_of_frequently]

/-- Source lines 701--705: membership in the liminf is eventual occurrence. -/
theorem mem_liminf_events_source {Ω : Type*} (A : ℕ → Set Ω) (ω : Ω) :
    ω ∈ Filter.liminf A Filter.atTop ↔ ∃ n, ∀ m ≥ n, ω ∈ A m := by
  simp [Filter.mem_liminf_of_eventually]

/-- Source lines 724--743, first Borel--Cantelli lemma. -/
theorem borelCantelli_first_source {Ω : Type*} [MeasurableSpace Ω]
    (μ : Measure Ω) (A : ℕ → Set Ω) (hA : ∀ n, MeasurableSet (A n))
    (hsum : ∑' n, μ (A n) ≠ ∞) :
    μ (Filter.limsup A Filter.atTop) = 0 :=
  MeasureTheory.measure_limsup_atTop_eq_zero hA hsum

/-- Source lines 747--777, second Borel--Cantelli lemma. -/
theorem borelCantelli_second_source {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (A : ℕ → Set Ω) (hA : ∀ n, MeasurableSet (A n))
    (hind : ProbabilityTheory.iIndepSet A P)
    (hsum : ∑' n, P (A n) = ∞) :
    P (Filter.limsup A Filter.atTop) = 1 :=
  ProbabilityTheory.measure_limsup_eq_one hA hind hsum

end ProbabilityAndMeasure
